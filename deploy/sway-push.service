[Unit]
Description=Sway Push Reminder Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/sway/apps/api
ExecStart=/home/ubuntu/.local/bin/uv run --frozen --project /home/ubuntu/sway/apps/api python -m api.push_worker
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
